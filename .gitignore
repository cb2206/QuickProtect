.env
*.p8
*.pfx
*.p12
*.cer
*.mobileprovision
*.snk

# Fastlane generated output
macos/fastlane/report.xml
macos/fastlane/Preview.html
macos/fastlane/test_output/

# --- dotnet/ (.NET port) ---
# Build/packaging artifacts
dotnet/dist/
TestResults/

# FFmpeg native libraries (fetched by dotnet/scripts/get-ffmpeg.*)
dotnet/native/
