# Copy to fastlane/.env and fill in. fastlane/.env is gitignored — never commit it.
#
# Generate the key in App Store Connect:
#   Users and Access -> Integrations -> App Store Connect API -> (+) Generate API Key
#   Role: "App Manager" (enough to push metadata + builds and submit).
#   Download the AuthKey_XXXXXXXXXX.p8 ONCE (Apple won't let you re-download it).
#
# Key ID: shown next to the key in the table (e.g. ABC123DEFG).
ASC_KEY_ID=

# Issuer ID: the UUID at the top of the App Store Connect API page.
ASC_ISSUER_ID=

# Path to the downloaded .p8 file. Keep it OUTSIDE the repo (e.g. ~/.appstoreconnect/).
# A leading ~ is expanded, so this works as-is once you drop in your key filename.
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
