    "Streams stay connected for this long after closing, so a quick reopen shows video instantly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams bleiben nach dem Schließen so lange verbunden – öffnest du schnell wieder, ist das Video sofort da"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux restent connectés pendant cette durée après la fermeture – la vidéo s'affiche instantanément à la réouverture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los streams permanecen conectados durante este tiempo tras cerrar, así el vídeo aparece al instante al reabrir"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams blijven na het sluiten zo lang verbonden, zodat de video direct terug is bij opnieuw openen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stream restano connessi per questo tempo dopo la chiusura, così il video appare subito alla riapertura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os streams permanecem conectados por esse tempo após fechar, para o vídeo aparecer na hora ao reabrir"
          }
        }
      }
    },
