    "Click the aperture icon in your menu bar to open the camera grid, or press your global shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das Blendensymbol in der Menüleiste, um das Kameraraster zu öffnen, oder drücke deinen globalen Kurzbefehl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l'icône de diaphragme dans la barre des menus pour ouvrir la grille des caméras, ou utilisez votre raccourci global."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de apertura en la barra de menús para abrir la cuadrícula de cámaras, o pulsa tu atajo global."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op het diafragmasymbool in de menubalk om het cameraraster te openen, of gebruik je globale sneltoets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull'icona del diaframma nella barra dei menu per aprire la griglia delle telecamere, oppure usa la tua scorciatoia globale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone de abertura na barra de menus para abrir a grade de câmeras, ou use seu atalho global."
          }
        }
      }
    },
