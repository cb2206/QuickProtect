    "PTZ control uses the classic Protect API, which requires a local account. The Integration API (API Key) does not expose PTZ endpoints.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PTZ-Steuerung nutzt die klassische Protect-API, die ein lokales Konto erfordert. Die Integrations-API (API-Schlüssel) bietet keine PTZ-Endpunkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle PTZ utilise l'API Protect classique, qui nécessite un compte local. L'API d'intégration (clé API) n'expose pas de points de terminaison PTZ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control PTZ usa la API clásica de Protect, que requiere una cuenta local. La API de integración (clave API) no expone endpoints PTZ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PTZ-bediening gebruikt de klassieke Protect-API, waarvoor een lokaal account nodig is. De integratie-API (API-sleutel) biedt geen PTZ-endpoints."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo PTZ usa l'API Protect classica, che richiede un account locale. L'API di integrazione (chiave API) non espone endpoint PTZ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle PTZ usa a API clássica do Protect, que exige uma conta local. A API de integração (chave de API) não expõe endpoints PTZ."
          }
        }
      }
    },
