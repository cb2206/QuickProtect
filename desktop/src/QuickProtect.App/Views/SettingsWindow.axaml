<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickProtect.App.ViewModels"
        xmlns:loc="clr-namespace:QuickProtect.App.Localization"
        x:Class="QuickProtect.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:Loc 'QuickProtect – Settings'}"
        Width="620" Height="640"
        Background="{DynamicResource QpPopoverBg}"
        WindowStartupLocation="CenterScreen"
        CanResize="True" MinWidth="520" MinHeight="500">

  <TabControl Margin="8">

    <!-- ============ CONNECTION ============ -->
    <TabItem Header="{loc:Loc 'Connection'}">
      <ScrollViewer>
        <StackPanel Margin="16" Spacing="14">

          <TextBlock Text="{loc:Loc 'Controller Connection'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource QpTextPrimary}" />

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'IP address or hostname'}" Foreground="{DynamicResource QpTextSecondary}" />
            <TextBox Text="{Binding IpAddress}" Watermark="192.168.1.1" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Integration API key'}" Foreground="{DynamicResource QpTextSecondary}" />
            <TextBox Text="{Binding ApiKey}" PasswordChar="•" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Default stream quality'}" Foreground="{DynamicResource QpTextSecondary}" />
            <ComboBox ItemsSource="{Binding QualityOptions}"
                      SelectedIndex="{Binding DefaultQualityIndex}" HorizontalAlignment="Left" Width="160" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Language'}" Foreground="{DynamicResource QpTextSecondary}" />
            <ComboBox ItemsSource="{Binding LanguageNames}"
                      SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Left" Width="200" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Appearance'}" Foreground="{DynamicResource QpTextSecondary}" />
            <ComboBox ItemsSource="{Binding AppearanceOptions}"
                      SelectedIndex="{Binding AppearanceIndex}" HorizontalAlignment="Left" Width="160" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Accent color'}" Foreground="{DynamicResource QpTextSecondary}" />
            <ComboBox ItemsSource="{Binding AccentNames}"
                      SelectedIndex="{Binding AccentIndex}" HorizontalAlignment="Left" Width="160" />
          </StackPanel>

          <Separator />

          <TextBlock Text="{loc:Loc 'PTZ control (optional)'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource QpTextPrimary}" />
          <TextBlock Text="{loc:Loc 'Local-account username and password enable pan/tilt/zoom and zoom-lens controls.'}"
                     Foreground="{DynamicResource QpTextTertiary}" TextWrapping="Wrap" FontSize="12" />

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Username'}" Foreground="{DynamicResource QpTextSecondary}" />
            <TextBox Text="{Binding Username}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Password'}" Foreground="{DynamicResource QpTextSecondary}" />
            <TextBox Text="{Binding Password}" PasswordChar="•" />
          </StackPanel>

          <Separator />

          <CheckBox Content="{loc:Loc 'Launch at login'}" IsChecked="{Binding LaunchAtLogin}" Foreground="{DynamicResource QpTextPrimary}" />
          <CheckBox Content="{loc:Loc 'Show focus-view controls (PTZ pad &amp; shortcut hints)'}"
                    IsChecked="{Binding ShowFocusOverlayControls}" Foreground="{DynamicResource QpTextPrimary}" />

          <Separator />

          <TextBlock Text="{loc:Loc 'Snapshots'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource QpTextPrimary}" />
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Save snapshots to'}" Foreground="{DynamicResource QpTextSecondary}" />
            <ComboBox ItemsSource="{Binding SnapshotDestinations}"
                      SelectedIndex="{Binding SnapshotDestinationIndex}" HorizontalAlignment="Left" Width="160" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Loc 'Choose Folder…'}" Command="{Binding ChooseSnapshotFolderCommand}" />
            <TextBlock Text="{Binding SnapshotFolderDisplay}" Foreground="{DynamicResource QpTextTertiary}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Global shortcut (toggle camera panel)'}" Foreground="{DynamicResource QpTextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{DynamicResource QpSubtleSurface}" CornerRadius="6" Padding="10,5" MinWidth="160"
                      BorderBrush="{DynamicResource QpDivider}" BorderThickness="1">
                <TextBlock Text="{Binding HotkeyDisplay}" Foreground="{DynamicResource QpTextPrimary}" VerticalAlignment="Center" />
              </Border>
              <Button Content="{loc:Loc 'Record'}" Command="{Binding RecordHotkeyCommand}" />
              <Button Content="{loc:Loc 'Clear'}" Command="{Binding ClearHotkeyCommand}" />
            </StackPanel>
            <TextBlock Text="{loc:Loc 'Windows only for now (letter, number, or function key with modifiers).'}"
                       Foreground="{DynamicResource QpTextHint}" FontSize="11" />
          </StackPanel>

          <Border Background="{DynamicResource QpStatusOrangeSurface}" Padding="12,8" CornerRadius="6"
                  IsVisible="{Binding HasPendingCert}">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Loc 'The controller\'s certificate changed since you last connected.'}"
                         Foreground="{DynamicResource QpTextPrimary}" TextWrapping="Wrap" />
              <Button Content="{loc:Loc 'Trust new certificate'}" Command="{Binding TrustNewCertificateCommand}" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{loc:Loc 'Test Connection'}" Command="{Binding TestConnectionCommand}" />
            <Button Content="{loc:Loc 'Save'}" Command="{Binding SaveCommand}" Classes="accent" />
          </StackPanel>

          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource QpTextSecondary}" TextWrapping="Wrap" />

          <Separator />

          <TextBlock Text="{loc:Loc 'Updates'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource QpTextPrimary}" />
          <Border Background="{DynamicResource QpStatusGreenSurface}" Padding="12,8" CornerRadius="6" IsVisible="{Binding UpdateAvailable}">
            <StackPanel Spacing="8">
              <TextBlock Foreground="{DynamicResource QpTextPrimary}" TextWrapping="Wrap"
                         Text="{Binding UpdateBannerText}" />
              <Button Content="{loc:Loc 'Open Release Page'}" Command="{Binding OpenReleasePageCommand}" />
            </StackPanel>
          </Border>
          <Button Content="{loc:Loc 'Check for Updates'}" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" />

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ============ CAMERAS & LAYOUT ============ -->
    <!-- NOTE: bindings go through Layout.* from the window's SettingsViewModel.
         Setting DataContext + x:DataType on the TabItem itself breaks compiled
         bindings (the DataContext binding is typed against the *child* type and
         never resolves — the tab renders empty). -->
    <TabItem Header="{loc:Loc 'Cameras &amp; Layout'}">
      <DockPanel Margin="16">

        <!-- Profile switcher -->
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock Text="{loc:Loc 'Layout profile'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource QpTextPrimary}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Layout.ProfileNames}" SelectedIndex="{Binding Layout.SelectedProfileIndex}"
                      MinWidth="180" />
            <Button Content="{loc:Loc 'Delete'}" Command="{Binding Layout.DeleteProfileCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding Layout.NewProfileName}" Watermark="{loc:Loc 'New profile name'}" Width="200" />
            <Button Content="{loc:Loc 'Create'}" Command="{Binding Layout.CreateProfileCommand}" />
            <Button Content="{loc:Loc 'Rename'}" Command="{Binding Layout.RenameProfileCommand}" />
          </StackPanel>
          <Separator />
          <TextBlock Text="{loc:Loc 'Cameras'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource QpTextPrimary}" />
          <TextBlock Text="{loc:Loc 'Toggle visibility, set tile size, and reorder. Applies to this profile.'}"
                     Foreground="{DynamicResource QpTextTertiary}" FontSize="12" />
        </StackPanel>

        <!-- Camera rows -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Layout.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CameraRowViewModel">
                <Border Background="{DynamicResource QpSubtleSurface}" CornerRadius="6" Padding="10,6" Margin="0,3"
                        BorderBrush="{DynamicResource QpChipBorder}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource QpTextPrimary}"
                               VerticalAlignment="Center" Margin="6,0" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SizeOptions}"
                              SelectedIndex="{Binding SizeIndex}" Width="110" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                      <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="8,2" />
                      <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="8,2" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

  </TabControl>
</Window>
