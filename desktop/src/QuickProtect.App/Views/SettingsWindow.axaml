<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickProtect.App.ViewModels"
        xmlns:loc="clr-namespace:QuickProtect.App.Localization"
        x:Class="QuickProtect.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="QuickProtect – Settings"
        Width="620" Height="640"
        Background="{StaticResource AuroraBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        CanResize="True" MinWidth="520" MinHeight="500">

  <TabControl Margin="8">

    <!-- ============ CONNECTION ============ -->
    <TabItem Header="Connection">
      <ScrollViewer>
        <StackPanel Margin="16" Spacing="14">

          <TextBlock Text="Controller Connection" FontSize="18" FontWeight="SemiBold" Foreground="White" />

          <StackPanel Spacing="4">
            <TextBlock Text="IP address or hostname" Foreground="#CCFFFFFF" />
            <TextBox Text="{Binding IpAddress}" Watermark="192.168.1.1" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Integration API key" Foreground="#CCFFFFFF" />
            <TextBox Text="{Binding ApiKey}" PasswordChar="•" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Default stream quality'}" Foreground="#CCFFFFFF" />
            <ComboBox ItemsSource="{Binding QualityOptions}"
                      SelectedIndex="{Binding DefaultQualityIndex}" HorizontalAlignment="Left" Width="160" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Language" Foreground="#CCFFFFFF" />
            <ComboBox ItemsSource="{Binding LanguageNames}"
                      SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Left" Width="200" />
          </StackPanel>

          <Separator />

          <TextBlock Text="PTZ Control (optional)" FontSize="16" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Local-account username and password enable pan/tilt/zoom and zoom-lens controls."
                     Foreground="#99FFFFFF" TextWrapping="Wrap" FontSize="12" />

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Username'}" Foreground="#CCFFFFFF" />
            <TextBox Text="{Binding Username}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc 'Password'}" Foreground="#CCFFFFFF" />
            <TextBox Text="{Binding Password}" PasswordChar="•" />
          </StackPanel>

          <Separator />

          <CheckBox Content="{loc:Loc 'Launch at login'}" IsChecked="{Binding LaunchAtLogin}" Foreground="White" />

          <StackPanel Spacing="4">
            <TextBlock Text="Global shortcut (toggle camera panel)" Foreground="#CCFFFFFF" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,5" MinWidth="160">
                <TextBlock Text="{Binding HotkeyDisplay}" Foreground="White" VerticalAlignment="Center" />
              </Border>
              <Button Content="Record" Command="{Binding RecordHotkeyCommand}" />
              <Button Content="Clear" Command="{Binding ClearHotkeyCommand}" />
            </StackPanel>
            <TextBlock Text="Windows only for now (letter, number, or function key with modifiers)."
                       Foreground="#80FFFFFF" FontSize="11" />
          </StackPanel>

          <Border Background="#33FF9500" Padding="12,8" CornerRadius="6"
                  IsVisible="{Binding HasPendingCert}">
            <StackPanel Spacing="8">
              <TextBlock Text="The controller's certificate changed since you last connected."
                         Foreground="White" TextWrapping="Wrap" />
              <Button Content="{loc:Loc 'Trust new certificate'}" Command="{Binding TrustNewCertificateCommand}" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{loc:Loc 'Test Connection'}" Command="{Binding TestConnectionCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
          </StackPanel>

          <TextBlock Text="{Binding StatusMessage}" Foreground="#CCFFFFFF" TextWrapping="Wrap" />

          <Separator />

          <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" Foreground="White" />
          <Border Background="#3330D158" Padding="12,8" CornerRadius="6" IsVisible="{Binding UpdateAvailable}">
            <StackPanel Spacing="8">
              <TextBlock Foreground="White" TextWrapping="Wrap"
                         Text="{Binding UpdateVersion, StringFormat='A new version ({0}) is available.'}" />
              <Button Content="Open Release Page" Command="{Binding OpenReleasePageCommand}" />
            </StackPanel>
          </Border>
          <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" />

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ============ CAMERAS & LAYOUT ============ -->
    <TabItem Header="Cameras &amp; Layout" DataContext="{Binding Layout}" x:DataType="vm:LayoutViewModel">
      <DockPanel Margin="16">

        <!-- Profile switcher -->
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock Text="Layout profile" FontSize="16" FontWeight="SemiBold" Foreground="White" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding ProfileNames}" SelectedIndex="{Binding SelectedProfileIndex}"
                      MinWidth="180" />
            <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding NewProfileName}" Watermark="New profile name" Width="200" />
            <Button Content="Create" Command="{Binding CreateProfileCommand}" />
            <Button Content="Rename" Command="{Binding RenameProfileCommand}" />
          </StackPanel>
          <Separator />
          <TextBlock Text="Cameras" FontSize="16" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Toggle visibility, set tile size, and reorder. Applies to this profile."
                     Foreground="#99FFFFFF" FontSize="12" />
        </StackPanel>

        <!-- Camera rows -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CameraRowViewModel">
                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,6" Margin="0,3">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White"
                               VerticalAlignment="Center" Margin="6,0" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SizeOptions}"
                              SelectedIndex="{Binding SizeIndex}" Width="110" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                      <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="8,2" />
                      <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="8,2" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

  </TabControl>
</Window>
