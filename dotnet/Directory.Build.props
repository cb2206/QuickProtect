<Project>
  <!-- Shared build settings for the cross-platform (Windows + Linux) QuickProtect port. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.3</Version>
    <Company>Christian Bartels</Company>
    <Product>QuickProtect</Product>
    <Copyright>Copyright © 2026 Christian Bartels. All rights reserved.</Copyright>
  </PropertyGroup>
</Project>
