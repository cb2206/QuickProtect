# Maintainer: Christian Bartels <hello@quickprotect.app>
#
# AUR package for the GitHub-release Linux tarball (built by
# .github/workflows/release.yml). To publish a new version: bump pkgver, set
# sha256sums_<arch> to the release assets' digests (SHA256SUMS on the release,
# or run `updpkgsums`), `makepkg --printsrcinfo > .SRCINFO`, then push to the
# AUR repo. Both architectures come from the same release (arm64 since 1.4).
# FFmpeg is bundled in the tarball (LGPL shared, BtbN builds), so no ffmpeg
# dependency here; ALSA is optional (video-only
# without it), the global hotkey uses the XDG Desktop Portal.

pkgname=quickprotect-bin
pkgver=1.4
pkgrel=1
pkgdesc="Live viewer for UniFi Protect cameras — grid, focus view, PTZ, snapshots, tray app"
arch=('x86_64' 'aarch64')
url="https://github.com/cb2206/QuickProtect"
# MIT for QuickProtect itself; the bundled FFmpeg libraries are LGPL-2.1+,
# the FFmpeg.AutoGen bindings LGPL-3.0+, the Inter font OFL-1.1 (see the
# THIRD-PARTY-NOTICES.txt installed alongside).
license=('MIT' 'LGPL-2.1-or-later' 'LGPL-3.0-or-later' 'OFL-1.1')
provides=('quickprotect')
conflicts=('quickprotect')
optdepends=('alsa-lib: audio playback'
            'xdg-desktop-portal: global hotkey support')
options=('!strip')
source_x86_64=("$url/releases/download/v$pkgver/QuickProtect-$pkgver-linux-x64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/QuickProtect-$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('3d780ccc538cf8b26403b376f73e8c7a66d31d751612f994dc33b421d6b3c7da')
sha256sums_aarch64=('f21d898ba20a78056af27d740982b21338fe7d9424b66710704fb32dfde6b59e')

package() {
    local rid=linux-x64
    [[ $CARCH == aarch64 ]] && rid=linux-arm64
    cd "QuickProtect-$pkgver-$rid"

    install -dm755 "$pkgdir/opt/quickprotect"
    cp -a QuickProtect/. "$pkgdir/opt/quickprotect/"
    chmod 755 "$pkgdir/opt/quickprotect/QuickProtect"

    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/quickprotect/QuickProtect "$pkgdir/usr/bin/quickprotect"

    install -Dm644 quickprotect.desktop \
        "$pkgdir/usr/share/applications/quickprotect.desktop"
    install -Dm644 quickprotect.png \
        "$pkgdir/usr/share/pixmaps/quickprotect.png"

    install -Dm644 QuickProtect/LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 QuickProtect/THIRD-PARTY-NOTICES.txt \
        "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
}
