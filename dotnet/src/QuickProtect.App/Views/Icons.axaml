<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- UI icons as vector geometry, rendered through PathIcon so they take the
       surrounding Foreground. These replace Unicode symbols (⚙ ⏻ ⇄ ✛ ▦ ⌨ ⤓ ＋ －
       ◳ ✕ and the 🔊 🔇 📌 emoji) that relied on system font fallback: none of them
       are in the bundled Inter, Avalonia 12 no longer falls back to a system font
       for them, and which symbol fonts exist varies by distro and OS anyway.

       Every geometry lives in a 16x16 box. PathIcon stretches the geometry bounds
       uniformly, so each path starts with zero-area points at (0,0) and (16,16) to
       pin the bounds to that box — otherwise a minus sign would scale up to the
       width of a plus. F0 = even-odd fill (shapes with holes), F1 = non-zero. -->
  <StreamGeometry x:Key="Icon.Plus">F1 M0,0 L0,0 M16,16 L16,16 M7,2.5 H9 V7 H13.5 V9 H9 V13.5 H7 V9 H2.5 V7 H7 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Minus">F1 M0,0 L0,0 M16,16 L16,16 M2.5,7 H13.5 V9 H2.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">F1 M0,0 L0,0 M16,16 L16,16 M2.86,4.14 L11.86,13.14 L13.14,11.86 L4.14,2.86 Z M11.86,2.86 L2.86,11.86 L4.14,13.14 L13.14,4.14 Z</StreamGeometry>
