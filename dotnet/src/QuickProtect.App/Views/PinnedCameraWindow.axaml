<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:vm="clr-namespace:QuickProtect.App.ViewModels"
        x:Class="QuickProtect.App.Views.PinnedCameraWindow"
        x:DataType="vm:CameraTileViewModel"
        Title="QuickProtect"
        Width="360" Height="203"
        MinWidth="200" MinHeight="120"
        Topmost="True"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Black"
        CanResize="True">

  <DockPanel>
    <!-- Drag handle + controls. Docked so the native VideoView never covers it. -->
    <Border DockPanel.Dock="Top" Background="#E6141416" PointerPressed="Header_Drag" Name="Header">
      <Grid ColumnDefinitions="*,Auto" Margin="8,4">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="●" Foreground="#FF3B30" FontSize="8" VerticalAlignment="Center"
                     IsVisible="{Binding IsOnline}" />
          <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Click="Unpin_Click"
                Background="Transparent" Foreground="#CCFFFFFF" BorderThickness="0"
                Padding="6,0" FontSize="11" ToolTip.Tip="Unpin" />
      </Grid>
    </Border>

    <Grid>
      <vlc:VideoView MediaPlayer="{Binding Player}" />
      <ProgressBar IsIndeterminate="True" Width="50" Height="4"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsLoading}" />
    </Grid>
  </DockPanel>
</Window>
