<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:video="clr-namespace:QuickProtect.App.Video"
        xmlns:vm="clr-namespace:QuickProtect.App.ViewModels"
        xmlns:loc="clr-namespace:QuickProtect.App.Localization"
        xmlns:views="clr-namespace:QuickProtect.App.Views"
        x:Class="QuickProtect.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="QuickProtect"
        Width="760" Height="520"
        MinWidth="400" MinHeight="300"
        Background="{DynamicResource QpPopoverBg}"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Grid>

    <!-- ============ GRID MODE ============ -->
    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsGridMode}"
          Background="{DynamicResource QpGridBg}">

      <!-- Header (Aurora chrome: translucent bar with a hairline bottom border).
           Also the popover's drag handle — the window has no title bar. -->
      <Border Grid.Row="0" Background="{DynamicResource QpChrome}"
              BorderBrush="{DynamicResource QpChromeBorder}" BorderThickness="0,0,0,1"
              PointerPressed="Header_PointerPressed">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="14,10">
          <TextBlock Grid.Column="0" Text="QuickProtect" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource QpTextPrimary}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <!-- Status pill: online stream count -->
          <Border Grid.Column="1" Background="{DynamicResource QpStatusGreenSurface}"
                  CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource QpStatusGreen}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StreamCountLabel}"
                         Foreground="{DynamicResource QpStatusGreenText}" FontSize="11" />
            </StackPanel>
          </Border>
          <!-- Layout-profile switcher + save-current-view-as-profile -->
          <ComboBox Grid.Column="2" ItemsSource="{Binding ProfileNames}" SelectedIndex="{Binding SelectedProfileIndex}"
                    MinWidth="120" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button Grid.Column="3" Content="＋" Click="Header_SaveProfile" Margin="4,0,0,0"
                  Background="Transparent" Foreground="{DynamicResource QpTextSecondary}" BorderThickness="0"
                  ToolTip.Tip="{loc:Loc 'Save Current View as New Profile…'}" />

          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                         IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
            <TextBox Text="{Binding SearchQuery}" Watermark="{loc:Loc 'Search'}" Width="130"
                     Classes="clearButton"
                     Background="{DynamicResource QpSubtleSurface}" CornerRadius="6"
                     BorderBrush="{DynamicResource QpChipBorder}" />
          </StackPanel>
          <Button Grid.Column="6" Content="{loc:Loc 'Refresh'}" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                  Background="{DynamicResource QpSubtleSurface}" CornerRadius="6" />
          <Button Grid.Column="7" Content="⚙" Click="Header_Settings" Margin="6,0,0,0" FontSize="15"
                  Background="Transparent" Foreground="{DynamicResource QpTextSecondary}" BorderThickness="0"
                  ToolTip.Tip="{loc:Loc 'Settings…'}" />
          <Button Grid.Column="8" Content="⏻" Click="Header_Quit" Margin="2,0,0,0" FontSize="14"
                  Background="Transparent" Foreground="{DynamicResource QpTextSecondary}" BorderThickness="0"
                  ToolTip.Tip="{loc:Loc 'Quit QuickProtect'}" />
        </Grid>
      </Border>

      <!-- Error banner (own layout row so it never fights the tiles). -->
      <Border Grid.Row="1" Background="{DynamicResource QpStatusRedSurface}" Padding="12,8"
              CornerRadius="6" Margin="14,10,14,0"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource QpTextPrimary}" TextWrapping="Wrap" />
      </Border>

      <!-- Empty state -->
      <TextBlock Grid.Row="2" Text="{loc:Loc 'No cameras yet. Open Settings to connect your controller.'}"
                 Foreground="{DynamicResource QpTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                 IsVisible="{Binding !HasCameras}" />

      <!-- Camera grid. Video is composited, so the whole tile is a click target:
           click focuses, drag reorders, right-click opens the context menu.
           Tiles stay pinned to the Dark variant like macOS. -->
      <ThemeVariantScope Grid.Row="2" RequestedThemeVariant="Dark" IsVisible="{Binding HasCameras}">
        <ScrollViewer Name="GridScroll" SizeChanged="GridScroll_SizeChanged">
          <ItemsControl ItemsSource="{Binding Tiles}" Margin="1">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <views:CenteredWrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CameraTileViewModel">
                <Border Width="{Binding TileWidth}" Height="{Binding TileHeight}" Margin="1" CornerRadius="8"
                        Background="{DynamicResource QpVideoBg}" ClipToBounds="True" IsVisible="{Binding MatchesSearch}"
                        ContextRequested="Tile_ContextRequested">
                  <Grid>
                    <video:VideoSurface Source="{Binding Client}" Fill="True" />
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding IsLoading}" />
                    <TextBlock Text="{loc:Loc 'Offline'}" Foreground="{DynamicResource QpTextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !IsOnline}" />
                    <TextBlock Text="{loc:Loc 'Video unavailable'}" Foreground="{DynamicResource QpTextTertiary}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding VideoUnavailable}" />
                    <!-- Name chip overlays the video bottom-left (macOS AuroraCameraCell) -->
                    <Border Background="{DynamicResource QpChip}" CornerRadius="6" Padding="8,4" Margin="8"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="●" Foreground="{DynamicResource QpStatusRed}" FontSize="8" VerticalAlignment="Center"
                                   IsVisible="{Binding IsOnline}" />
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QpTextPrimary}" />
                        <TextBlock Text="PTZ" FontSize="9" Foreground="{DynamicResource QpAccentText}"
                                   VerticalAlignment="Center" IsVisible="{Binding IsPtz}" />
                      </StackPanel>
                    </Border>
                    <!-- Secondary-lens PiP (package camera), bottom-right — compact,
                         display-only; enabled per camera in Settings → Cameras -->
                    <Border Width="{Binding GridPipWidth}" Height="{Binding GridPipHeight}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                            CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource QpVideoBg}"
                            BorderBrush="{DynamicResource QpChipBorder}" BorderThickness="1"
                            IsVisible="{Binding GridPipVisible}">
                      <video:VideoSurface Source="{Binding GridPip.Client}" Fill="True" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </ThemeVariantScope>
    </Grid>

    <!-- ============ FOCUS MODE ============ -->
    <!-- Composited video with true overlays (macOS AuroraFocusOverlay parity):
         chrome on top, PTZ pad + hints + PiP floating over the frame. -->
    <ThemeVariantScope RequestedThemeVariant="Dark" IsVisible="{Binding IsFocusMode}">
      <Grid Name="FocusRoot" Background="{DynamicResource QpVideoBg}" SizeChanged="FocusRoot_SizeChanged"
            Focusable="True">

        <video:VideoSurface Name="FocusSurface" Source="{Binding FocusTile.Client}"
                            Fill="{Binding FocusTile.FillMode}"
                            Zoom="{Binding FocusTile.Zoom}"
                            ZoomCenterX="{Binding FocusTile.ZoomCenterX}"
                            ZoomCenterY="{Binding FocusTile.ZoomCenterY}"
                            PointerPressed="FocusSurface_PointerPressed"
                            PointerMoved="FocusSurface_PointerMoved"
                            PointerReleased="FocusSurface_PointerReleased"
                            PointerWheelChanged="FocusSurface_PointerWheelChanged" />

        <!-- Top chrome bar (auto-hides in fullscreen) -->
        <Border VerticalAlignment="Top" Background="{DynamicResource QpChrome}" Padding="10,7"
                IsVisible="{Binding ChromeVisible}">
          <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding FocusTile}"
                x:DataType="vm:CameraTileViewModel">
            <Button Grid.Column="0" Click="Focus_Back"
                    Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0">
              <TextBlock><Run Text="◀ " /><Run Text="{loc:Loc 'Grid'}" /></TextBlock>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="●" Foreground="{DynamicResource QpStatusRed}" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource QpTextPrimary}" FontWeight="SemiBold" FontSize="13" />
              <Border IsVisible="{Binding IsPtz}" Background="{DynamicResource QpAccentSurface}" CornerRadius="9" Padding="7,2">
                <TextBlock Text="{loc:Loc 'PTZ · ARROW KEYS'}" Foreground="{DynamicResource QpTextSecondary}" FontSize="9" />
              </Border>
              <Border IsVisible="{Binding DigitalZoomLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="{DynamicResource QpAccentSurface}" CornerRadius="9" Padding="7,2">
                <TextBlock Text="{Binding DigitalZoomLabel}" Foreground="{DynamicResource QpTextSecondary}" FontSize="9" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Click="Focus_Fill"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Toggle fit vs. fill'}">
                <TextBlock><Run Text="◳ " /><Run Text="{loc:Loc 'Fit/Fill'}" /></TextBlock>
              </Button>
              <Button Click="Focus_Mute" IsVisible="{Binding HasAudio}"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Toggle audio'}">
                <Panel>
                  <TextBlock Text="{loc:Loc 'Mute (M)'}" IsVisible="{Binding !IsMuted}" />
                  <TextBlock Text="{loc:Loc 'Unmute (M)'}" IsVisible="{Binding IsMuted}" />
                </Panel>
              </Button>
              <Button Click="Focus_Snapshot"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Save a still frame'}">
                <TextBlock><Run Text="⤓ " /><Run Text="{loc:Loc 'Snapshot (S)'}" /></TextBlock>
              </Button>
              <Button Click="Focus_Pin"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Pin as an always-on-top window'}">
                <TextBlock><Run Text="📌 " /><Run Text="{loc:Loc 'Pin'}" /></TextBlock>
              </Button>
              <Button Content="{loc:Loc 'Fullscreen (F)'}" Click="Focus_ToggleFullscreen"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- PTZ controls overlaid bottom-right (macOS AuroraPtzDpad/ZoomControl) -->
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,16"
                    IsVisible="{Binding ControlsVisible}">
          <StackPanel Orientation="Horizontal" Spacing="10"
                      DataContext="{Binding FocusTile}" x:DataType="vm:CameraTileViewModel">
            <Grid IsVisible="{Binding IsPtz}" Width="96" Height="96"
                  RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
              <Border Grid.Row="0" Grid.Column="1" Classes="dpad" Tag="Up" Classes.active="{Binding PtzUpActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="▲" Classes="dpadGlyph" />
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Classes="dpad" Tag="Left" Classes.active="{Binding PtzLeftActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="◀" Classes="dpadGlyph" />
              </Border>
              <Border Grid.Row="1" Grid.Column="2" Classes="dpad" Tag="Right" Classes.active="{Binding PtzRightActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="▶" Classes="dpadGlyph" />
              </Border>
              <Border Grid.Row="2" Grid.Column="1" Classes="dpad" Tag="Down" Classes.active="{Binding PtzDownActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="▼" Classes="dpadGlyph" />
              </Border>
              <Ellipse Grid.Row="1" Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource QpTextTertiary}" />
            </Grid>
            <StackPanel IsVisible="{Binding CanZoom}" VerticalAlignment="Center" Spacing="4">
              <Border Classes="dpad" Tag="ZoomIn" Width="34" Height="34" Classes.active="{Binding PtzZoomInActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="＋" Classes="dpadGlyph" />
              </Border>
              <Border Classes="dpad" Tag="ZoomOut" Width="34" Height="34" Classes.active="{Binding PtzZoomOutActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="－" Classes="dpadGlyph" />
              </Border>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Keyboard hints, bottom-left (macOS AuroraFocusHints) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                Background="{DynamicResource QpChip}" CornerRadius="8" Padding="10,6"
                IsVisible="{Binding ControlsVisible}">
          <TextBlock Text="{loc:Loc 'Click video: back · F fullscreen · arrows pan/tilt · I/O zoom · scroll pan · Ctrl+scroll digital zoom (0 resets)'}"
                     Foreground="{DynamicResource QpTextHint}" FontSize="11" />
        </Border>

        <!-- Secondary-lens PiP: bottom-right overlay, tap (or C) to swap -->
        <Border Name="PipBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,120" Width="220" Height="180"
                CornerRadius="7" ClipToBounds="True"
                BorderBrush="{DynamicResource QpChipBorder}" BorderThickness="1"
                Background="{DynamicResource QpVideoBg}"
                IsVisible="{Binding HasSecondary}"
                PointerReleased="Pip_Clicked">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource QpChip}" Padding="6,3">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{loc:Loc 'Package camera'}" Foreground="{DynamicResource QpTextSecondary}" FontSize="10" />
                <TextBlock Text="⇄" Foreground="{DynamicResource QpTextSecondary}" FontSize="10" />
                <Border Background="{DynamicResource QpControlSurface}" CornerRadius="3" Padding="4,0">
                  <TextBlock Text="C" Foreground="{DynamicResource QpTextSecondary}" FontSize="9" />
                </Border>
              </StackPanel>
            </Border>
            <video:VideoSurface Grid.Row="1" Source="{Binding SecondaryTile.Client}" Fill="True" />
          </Grid>
        </Border>

        <!-- Transient status toast -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                Background="{DynamicResource QpAccentStrong}" Padding="12,5" CornerRadius="6"
                IsVisible="{Binding StatusToast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding StatusToast}" Foreground="{DynamicResource QpTextPrimary}" FontSize="12" />
        </Border>
      </Grid>
    </ThemeVariantScope>
  </Grid>

  <Window.Styles>
    <Style Selector="Border.dpad">
      <Setter Property="Background" Value="{DynamicResource QpChip}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="Border.dpad:pointerover">
      <Setter Property="Background" Value="{DynamicResource QpControlSurfaceHover}" />
    </Style>
    <!-- Lit while its direction is driven (keyboard or pointer) — macOS DpadButton. -->
    <Style Selector="Border.dpad.active">
      <Setter Property="Background" Value="#2EFFFFFF" />
    </Style>
    <Style Selector="Border.dpad.active TextBlock.dpadGlyph">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.dpadGlyph">
      <Setter Property="Foreground" Value="{DynamicResource QpTextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
</Window>
