<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:video="clr-namespace:QuickProtect.App.Video"
        xmlns:vm="clr-namespace:QuickProtect.App.ViewModels"
        xmlns:loc="clr-namespace:QuickProtect.App.Localization"
        xmlns:views="clr-namespace:QuickProtect.App.Views"
        x:Class="QuickProtect.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="QuickProtect"
        Width="760" Height="520"
        MinWidth="400" MinHeight="300"
        Background="{DynamicResource QpPopoverBg}"
        ShowInTaskbar="False"
        WindowDecorations="None">

  <Grid>

    <!-- ============ GRID MODE ============ -->
    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsGridMode}"
          Background="{DynamicResource QpGridBg}">

      <!-- Header (Aurora chrome: translucent bar with a hairline bottom border).
           Also the popover's drag handle — the window has no title bar. -->
      <Border Grid.Row="0" Background="{DynamicResource QpChrome}"
              BorderBrush="{DynamicResource QpChromeBorder}" BorderThickness="0,0,0,1"
              PointerPressed="Header_PointerPressed">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="14,10">
          <TextBlock Grid.Column="0" Text="QuickProtect" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource QpTextPrimary}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <!-- Status pill: online stream count -->
          <Border Grid.Column="1" Background="{DynamicResource QpStatusGreenSurface}"
                  CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource QpStatusGreen}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StreamCountLabel}"
                         Foreground="{DynamicResource QpStatusGreenText}" FontSize="11" />
            </StackPanel>
          </Border>
          <!-- Layout-profile switcher + save-current-view-as-profile -->
          <ComboBox Grid.Column="2" ItemsSource="{Binding ProfileNames}" SelectedIndex="{Binding SelectedProfileIndex}"
                    MinWidth="120" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button Grid.Column="3" Click="Header_SaveProfile" Margin="4,0,0,0"
                  Background="Transparent" Foreground="{DynamicResource QpTextSecondary}" BorderThickness="0"
                  ToolTip.Tip="{loc:Loc 'Save Current View as New Profile…'}">
            <PathIcon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
          </Button>

          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                         IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
            <TextBox Text="{Binding SearchQuery}" PlaceholderText="{loc:Loc 'Search'}" Width="130"
                     Classes="clearButton"
                     Background="{DynamicResource QpSubtleSurface}" CornerRadius="6"
                     BorderBrush="{DynamicResource QpChipBorder}" />
          </StackPanel>
          <Button Grid.Column="6" Content="{loc:Loc 'Refresh'}" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                  Background="{DynamicResource QpSubtleSurface}" CornerRadius="6" />
          <Button Grid.Column="7" Click="Header_Settings" Margin="6,0,0,0"
                  Background="Transparent" Foreground="{DynamicResource QpTextSecondary}" BorderThickness="0"
                  ToolTip.Tip="{loc:Loc 'Settings…'}">
            <PathIcon Data="{StaticResource Icon.Gear}" Width="15" Height="15" />
          </Button>
          <Button Grid.Column="8" Click="Header_Quit" Margin="2,0,0,0"
                  Background="Transparent" Foreground="{DynamicResource QpTextSecondary}" BorderThickness="0"
                  ToolTip.Tip="{loc:Loc 'Quit QuickProtect'}">
            <PathIcon Data="{StaticResource Icon.Power}" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>

      <!-- Error banner (own layout row so it never fights the tiles). -->
      <Border Grid.Row="1" Background="{DynamicResource QpStatusRedSurface}" Padding="12,8"
              CornerRadius="6" Margin="14,10,14,0"
              IsVisible="{Binding ShowErrorBanner}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource QpTextPrimary}" TextWrapping="Wrap" />
      </Border>

      <!-- Empty state -->
      <TextBlock Grid.Row="2" Text="{loc:Loc 'No cameras yet. Open Settings to connect your controller.'}"
                 Foreground="{DynamicResource QpTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                 IsVisible="{Binding ShowEmptyState}" />

      <!-- Certificate changed: every request fails until the user decides, so
           this card replaces the grid (macOS CameraGridView parity). -->
      <Border Grid.Row="2" IsVisible="{Binding HasCertificateChange}"
              HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24"
              Background="{DynamicResource QpStatusOrangeSurface}" CornerRadius="10" Padding="22,18">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Lock}" Width="22" Height="22"
                    Foreground="{DynamicResource QpTextPrimary}" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Loc 'Controller certificate changed'}" FontWeight="SemiBold" FontSize="14"
                     Foreground="{DynamicResource QpTextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{loc:Loc 'QuickProtect stopped connecting because the controller presented a different certificate. This is expected after reinstalling, resetting or replacing the controller. If you didn\'t, someone may be intercepting the connection.'}"
                     Foreground="{DynamicResource QpTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
            <Button Content="{loc:Loc 'Review Certificate…'}" Click="Certificate_Review" Classes="accent" />
            <Button Content="{loc:Loc 'Open Settings'}" Click="Header_Settings" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Camera grid. Video is composited, so the whole tile is a click target:
           click focuses, drag reorders, right-click opens the context menu.
           Tiles stay pinned to the Dark variant like macOS. -->
      <ThemeVariantScope Grid.Row="2" RequestedThemeVariant="Dark" IsVisible="{Binding ShowGrid}">
        <ScrollViewer Name="GridScroll" SizeChanged="GridScroll_SizeChanged">
          <ItemsControl ItemsSource="{Binding Tiles}" Margin="1">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <views:CenteredWrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CameraTileViewModel">
                <Border Width="{Binding TileWidth}" Height="{Binding TileHeight}" Margin="1" CornerRadius="8"
                        Background="{DynamicResource QpVideoBg}" ClipToBounds="True" IsVisible="{Binding MatchesSearch}"
                        ContextRequested="Tile_ContextRequested">
                  <Grid>
                    <video:VideoSurface Source="{Binding Client}" Fill="True" />
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding IsLoading}" />
                    <TextBlock Text="{loc:Loc 'Offline'}" Foreground="{DynamicResource QpTextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !IsOnline}" />
                    <TextBlock Text="{loc:Loc 'Video unavailable'}" Foreground="{DynamicResource QpTextTertiary}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding VideoUnavailable}" />
                    <!-- The engine's own reason when a stream fails (e.g. the controller
                         isn't receiving video from the camera), like the macOS failed tile. -->
                    <TextBlock Text="{Binding StreamFailure}" Foreground="{DynamicResource QpTextTertiary}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                               TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding StreamFailure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Name chip overlays the video bottom-left (macOS AuroraCameraCell) -->
                    <Border Background="{DynamicResource QpChip}" CornerRadius="6" Padding="8,4" Margin="8"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="●" Foreground="{DynamicResource QpStatusRed}" FontSize="8" VerticalAlignment="Center"
                                   IsVisible="{Binding IsOnline}" />
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QpTextPrimary}" />
                        <TextBlock Text="PTZ" FontSize="9" Foreground="{DynamicResource QpAccentText}"
                                   VerticalAlignment="Center" IsVisible="{Binding IsPtz}" />
                      </StackPanel>
                    </Border>
                    <!-- Secondary-lens PiP (package camera), bottom-right — compact,
                         display-only; enabled per camera in Settings → Cameras -->
                    <Border Width="{Binding GridPipWidth}" Height="{Binding GridPipHeight}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                            CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource QpVideoBg}"
                            BorderBrush="{DynamicResource QpChipBorder}" BorderThickness="1"
                            IsVisible="{Binding GridPipVisible}">
                      <video:VideoSurface Source="{Binding GridPip.Client}" Fill="True" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </ThemeVariantScope>
    </Grid>

    <!-- ============ FOCUS MODE ============ -->
    <!-- Composited video with true overlays (macOS AuroraFocusOverlay parity):
         chrome on top, PTZ pad + hints + PiP floating over the frame. -->
    <ThemeVariantScope RequestedThemeVariant="Dark" IsVisible="{Binding IsFocusMode}">
      <Grid Name="FocusRoot" Background="{DynamicResource QpVideoBg}" SizeChanged="FocusRoot_SizeChanged"
            Focusable="True">

        <video:VideoSurface Name="FocusSurface" Source="{Binding FocusTile.Client}"
                            Fill="{Binding FocusTile.FillMode}"
                            Zoom="{Binding FocusTile.Zoom}"
                            ZoomCenterX="{Binding FocusTile.ZoomCenterX}"
                            ZoomCenterY="{Binding FocusTile.ZoomCenterY}"
                            PointerPressed="FocusSurface_PointerPressed"
                            PointerMoved="FocusSurface_PointerMoved"
                            PointerReleased="FocusSurface_PointerReleased"
                            PointerWheelChanged="FocusSurface_PointerWheelChanged" />

        <!-- Top chrome bar (auto-hides in fullscreen) -->
        <Border VerticalAlignment="Top" Background="{DynamicResource QpChrome}" Padding="10,7"
                IsVisible="{Binding ChromeVisible}">
          <!-- Back / title / actions. Too narrow for the labels (long translations,
               small panel): the labels drop to icons with tooltips, then the
               camera name trims. See FocusHeaderPanel. -->
          <views:FocusHeaderPanel DataContext="{Binding FocusTile}"
                                  x:DataType="vm:CameraTileViewModel">
            <Button Click="Focus_Back" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc 'Grid'}"
                    Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                    ToolTip.Tip="{loc:Loc 'Grid'}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="◀" />
                <TextBlock Classes="headerLabel" Text="{loc:Loc 'Grid'}" />
              </StackPanel>
            </Button>
            <DockPanel VerticalAlignment="Center" Margin="8,0">
              <TextBlock DockPanel.Dock="Left" Text="●" Foreground="{DynamicResource QpStatusRed}" FontSize="9"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding DigitalZoomLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="{DynamicResource QpAccentSurface}" CornerRadius="9" Padding="7,2">
                <TextBlock Text="{Binding DigitalZoomLabel}" Foreground="{DynamicResource QpTextSecondary}" FontSize="9" />
              </Border>
              <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding IsPtz}" Background="{DynamicResource QpAccentSurface}" CornerRadius="9" Padding="7,2">
                <TextBlock Text="{loc:Loc 'PTZ · ARROW KEYS'}" Foreground="{DynamicResource QpTextSecondary}" FontSize="9" />
              </Border>
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource QpTextPrimary}" FontWeight="SemiBold" FontSize="13"
                         VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Click="Focus_Fill" AutomationProperties.Name="{loc:Loc 'Fit/Fill'}"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Toggle fit vs. fill'}">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.FitFill}" Width="12" Height="12" /><TextBlock Classes="headerLabel" Text="{loc:Loc 'Fit/Fill'}" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Click="Focus_Mute" IsVisible="{Binding HasAudio}" AutomationProperties.Name="{loc:Loc 'Toggle audio'}"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Toggle audio'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Panel VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Speaker}" Width="12" Height="12" IsVisible="{Binding !IsMuted}" />
                    <PathIcon Data="{StaticResource Icon.SpeakerMuted}" Width="12" Height="12" IsVisible="{Binding IsMuted}" />
                  </Panel>
                  <Panel Classes="headerLabel" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc 'Mute (M)'}" IsVisible="{Binding !IsMuted}" />
                    <TextBlock Text="{loc:Loc 'Unmute (M)'}" IsVisible="{Binding IsMuted}" />
                  </Panel>
                </StackPanel>
              </Button>
              <Button Click="Focus_Snapshot" AutomationProperties.Name="{loc:Loc 'Snapshot (S)'}"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Save a still frame'}">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Download}" Width="12" Height="12" /><TextBlock Classes="headerLabel" Text="{loc:Loc 'Snapshot (S)'}" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Click="Focus_Pin" AutomationProperties.Name="{loc:Loc 'Pin'}"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Pin as an always-on-top window'}">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Pin}" Width="12" Height="12" /><TextBlock Classes="headerLabel" Text="{loc:Loc 'Pin'}" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Click="Focus_ToggleFullscreen" AutomationProperties.Name="{loc:Loc 'Fullscreen (F)'}"
                      Background="Transparent" Foreground="{DynamicResource QpTextPrimary}" BorderThickness="0"
                      ToolTip.Tip="{loc:Loc 'Fullscreen (F)'}">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Fullscreen}" Width="12" Height="12" /><TextBlock Classes="headerLabel" Text="{loc:Loc 'Fullscreen (F)'}" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </views:FocusHeaderPanel>
        </Border>

        <!-- PTZ controls overlaid bottom-right (macOS AuroraPtzDpad/ZoomControl) -->
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,16"
                    IsVisible="{Binding ControlsVisible}">
          <StackPanel Orientation="Horizontal" Spacing="10"
                      DataContext="{Binding FocusTile}" x:DataType="vm:CameraTileViewModel">
            <Grid IsVisible="{Binding IsPtz}" Width="96" Height="96"
                  RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
              <Border Grid.Row="0" Grid.Column="1" Classes="dpad" Tag="Up" Classes.active="{Binding PtzUpActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="▲" Classes="dpadGlyph" />
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Classes="dpad" Tag="Left" Classes.active="{Binding PtzLeftActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="◀" Classes="dpadGlyph" />
              </Border>
              <Border Grid.Row="1" Grid.Column="2" Classes="dpad" Tag="Right" Classes.active="{Binding PtzRightActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="▶" Classes="dpadGlyph" />
              </Border>
              <Border Grid.Row="2" Grid.Column="1" Classes="dpad" Tag="Down" Classes.active="{Binding PtzDownActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <TextBlock Text="▼" Classes="dpadGlyph" />
              </Border>
              <Ellipse Grid.Row="1" Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource QpTextTertiary}" />
            </Grid>
            <StackPanel IsVisible="{Binding CanZoom}" VerticalAlignment="Center" Spacing="4">
              <Border Classes="dpad" Tag="ZoomIn" Width="34" Height="34" Classes.active="{Binding PtzZoomInActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <PathIcon Data="{StaticResource Icon.Plus}" Classes="dpadGlyph" />
              </Border>
              <Border Classes="dpad" Tag="ZoomOut" Width="34" Height="34" Classes.active="{Binding PtzZoomOutActive}"
                      PointerPressed="Dpad_Pressed" PointerReleased="Dpad_Released" PointerExited="Dpad_Exited">
                <PathIcon Data="{StaticResource Icon.Minus}" Classes="dpadGlyph" />
              </Border>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Keyboard hints, bottom-left (macOS AuroraFocusHints: keycap chips with
             labels on an ~85% dark backing — readable over any video scene) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                Background="#D9141416" CornerRadius="8" Padding="12,7"
                BorderBrush="#1AFFFFFF" BorderThickness="1"
                IsVisible="{Binding ControlsVisible}">
          <StackPanel Orientation="Horizontal" Spacing="14"
                      DataContext="{Binding FocusTile}" x:DataType="vm:CameraTileViewModel">
            <StackPanel Classes="hint">
              <Border Classes="keycap"><TextBlock Text="F" /></Border>
              <TextBlock Classes="hintLabel" Text="{loc:Loc 'Fullscreen'}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="keycap"><TextBlock Text="Esc" /></Border>
              <TextBlock Classes="hintLabel" Text="{loc:Loc 'Back'}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="keycap"><TextBlock Text="S" /></Border>
              <TextBlock Classes="hintLabel" Text="{loc:Loc 'Snapshot'}" />
            </StackPanel>
            <StackPanel Classes="hint" IsVisible="{Binding HasAudio}">
              <Border Classes="keycap"><TextBlock Text="M" /></Border>
              <TextBlock Classes="hintLabel" Text="{loc:Loc 'Mute'}" />
            </StackPanel>
            <StackPanel Classes="hint" IsVisible="{Binding IsPtz}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Border Classes="keycap"><TextBlock Text="←" /></Border>
                <Border Classes="keycap"><TextBlock Text="→" /></Border>
                <Border Classes="keycap"><TextBlock Text="↑" /></Border>
                <Border Classes="keycap"><TextBlock Text="↓" /></Border>
              </StackPanel>
              <TextBlock Classes="hintLabel" Text="{loc:Loc 'Pan / tilt'}" />
            </StackPanel>
            <StackPanel Classes="hint" IsVisible="{Binding CanZoom}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Border Classes="keycap"><TextBlock Text="I" /></Border>
                <Border Classes="keycap"><TextBlock Text="O" /></Border>
              </StackPanel>
              <TextBlock Classes="hintLabel" Text="{loc:Loc 'Zoom'}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Secondary-lens PiP: bottom-right overlay, tap (or C) to swap -->
        <Border Name="PipBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,120" Width="220" Height="180"
                CornerRadius="7" ClipToBounds="True"
                BorderBrush="{DynamicResource QpChipBorder}" BorderThickness="1"
                Background="{DynamicResource QpVideoBg}"
                IsVisible="{Binding HasSecondary}"
                PointerReleased="Pip_Clicked">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource QpChip}" Padding="6,3">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{loc:Loc 'Package camera'}" Foreground="{DynamicResource QpTextSecondary}" FontSize="10" />
                <PathIcon Data="{StaticResource Icon.Swap}" Foreground="{DynamicResource QpTextSecondary}" Width="10" Height="10" />
                <Border Background="{DynamicResource QpControlSurface}" CornerRadius="3" Padding="4,0">
                  <TextBlock Text="C" Foreground="{DynamicResource QpTextSecondary}" FontSize="9" />
                </Border>
              </StackPanel>
            </Border>
            <video:VideoSurface Grid.Row="1" Source="{Binding SecondaryTile.Client}" Fill="True" />
          </Grid>
        </Border>

        <!-- Transient status toast -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                Background="{DynamicResource QpAccentStrong}" Padding="12,5" CornerRadius="6"
                IsVisible="{Binding StatusToast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding StatusToast}" Foreground="{DynamicResource QpTextPrimary}" FontSize="12" />
        </Border>
      </Grid>
    </ThemeVariantScope>

    <!-- Edge/corner resize handles: the borderless panel has no window-manager frame. -->
    <views:ResizeGrips />
  </Grid>

  <Window.Styles>
    <!-- Focus header too narrow for its labels: icons (with tooltips) only. -->
    <Style Selector="views|FocusHeaderPanel:compact :is(Control).headerLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.dpad">
      <Setter Property="Background" Value="{DynamicResource QpChip}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="Border.dpad:pointerover">
      <Setter Property="Background" Value="{DynamicResource QpControlSurfaceHover}" />
    </Style>
    <!-- Lit while its direction is driven (keyboard or pointer) — macOS DpadButton. -->
    <Style Selector="Border.dpad.active">
      <Setter Property="Background" Value="#2EFFFFFF" />
    </Style>
    <Style Selector="Border.dpad.active TextBlock.dpadGlyph">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.dpad.active PathIcon.dpadGlyph">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="PathIcon.dpadGlyph">
      <Setter Property="Foreground" Value="{DynamicResource QpTextPrimary}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.dpadGlyph">
      <Setter Property="Foreground" Value="{DynamicResource QpTextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Focus-hint keycap chips (macOS AuroraFocusHints.Hint) -->
    <Style Selector="StackPanel.hint">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="5" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderBrush" Value="#2EFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keycap TextBlock">
      <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hintLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#CCFFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
</Window>
