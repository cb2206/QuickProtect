<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable domain layer: models, UniFi Protect API client, settings, cert pinning.
       No UI / no platform-windowing dependencies, so it builds identically on
       Windows and Linux (and macOS, for future Avalonia reuse). -->
  <PropertyGroup>
    <RootNamespace>QuickProtect.Core</RootNamespace>
    <AssemblyName>QuickProtect.Core</AssemblyName>
    <!-- Every RID the release scripts publish. Declared up front so restore
         writes their sections into packages.lock.json; otherwise each
         `dotnet publish -r` adds them and dirties the committed lock file. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI for the Windows secret store. The package is a no-op shim on
         non-Windows targets; we guard usage with OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
